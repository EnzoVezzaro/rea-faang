{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Company Schema",
  "type": "object",
  "required": ["id", "name", "common_name", "official_website", "date_last_verified"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Stable company identifier",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "description": "Official company name"
    },
    "common_name": {
      "type": "string",
      "description": "Commonly used name"
    },
    "former_names": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Former names and aliases"
    },
    "parent_organization": {
      "type": "string",
      "description": "Parent organization ID, if applicable"
    },
    "official_website": {
      "type": "string",
      "format": "uri",
      "description": "Official company website"
    },
    "product_directory": {
      "type": "string",
      "format": "uri",
      "description": "Official product directory"
    },
    "developer_portal": {
      "type": "string",
      "format": "uri",
      "description": "Developer portal URL"
    },
    "open_source_organization": {
      "type": "string",
      "format": "uri",
      "description": "Official open-source organization URL"
    },
    "engineering_blog": {
      "type": "string",
      "format": "uri",
      "description": "Engineering blog URL"
    },
    "research_portal": {
      "type": "string",
      "format": "uri",
      "description": "Research portal URL"
    },
    "brand_resource_page": {
      "type": "string",
      "format": "uri",
      "description": "Brand-resource page URL"
    },
    "subsidiaries": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Known subsidiary IDs"
    },
    "date_last_verified": {
      "type": "string",
      "format": "date",
      "description": "Date this record was last verified"
    },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/definitions/evidence" },
      "description": "Evidence supporting material claims"
    }
  },
  "definitions": {
    "evidence": {
      "type": "object",
      "required": ["id", "url", "source_type", "claim", "claim_type"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Stable evidence identifier"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "Source URL"
        },
        "source_type": {
          "type": "string",
          "enum": ["official_website", "developer_documentation", "engineering_blog", "press_release", "repository", "api_specification", "academic_paper", "secondary_source"],
          "description": "Type of source"
        },
        "publisher": {
          "type": "string",
          "description": "Publisher or author"
        },
        "title": {
          "type": "string",
          "description": "Source title"
        },
        "published_at": {
          "type": "string",
          "format": "date-time",
          "description": "Publication date"
        },
        "accessed_at": {
          "type": "string",
          "format": "date-time",
          "description": "Date accessed"
        },
        "claim": {
          "type": "string",
          "description": "Claim this evidence supports"
        },
        "claim_type": {
          "type": "string",
          "enum": ["product_identity", "capability", "pricing", "licensing", "ownership", "status", "api_surface"],
          "description": "Type of claim"
        },
        "supporting_excerpt_or_summary": {
          "type": "string",
          "description": "Summary or excerpt supporting the claim"
        },
        "reliability": {
          "type": "string",
          "enum": ["primary", "secondary", "tertiary"],
          "description": "Reliability ranking"
        },
        "verification_status": {
          "type": "string",
          "enum": ["verified", "unverified", "conflicting", "unavailable"],
          "description": "Verification status"
        },
        "related_product_ids": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Related product IDs"
        },
        "related_alternative_ids": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Related alternative IDs"
        }
      },
      "additionalProperties": false
    }
  }
}